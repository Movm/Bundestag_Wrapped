# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Env
.env
.env.local
.env.*.local

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Data / generated artifacts
data/
web-output/
exports/
results/
work/
apps/wrapped/.dev-editions/
!apps/wrapped/public/data/
!apps/wrapped/public/data/2026/
!apps/wrapped/public/data/2026/**

# Logs / OS
*.log
.DS_Store

# Editor
.idea/
.vscode/*
!.vscode/extensions.json

# Root .gitignore has a bare `data/`; the app bundles apps/wrapped/src/data (tracked).
!apps/wrapped/src/data/

# --- EAS upload only (.easignore replaces .gitignore for `eas build`) ---
# The app loads edition data, speaker files and sounds from https://bundestag-wrapped.de
# at runtime; only the files it require()s are bundled (cover eagle, start sound).
apps/wrapped/public/data/
apps/wrapped/public/speakers/
apps/wrapped/public/speaker-enrichment/
apps/wrapped/public/*.json
apps/wrapped/public/sounds/*
!apps/wrapped/public/sounds/start.wav
apps/wrapped/screenshots/
apps/wrapped/docs/
services/analysis/

# --- nested .gitignore files (an .easignore replaces all of them) ---
apps/wrapped-app/**/node_modules
apps/wrapped-app/**/dist-check
apps/wrapped-app/**/.expo
apps/wrapped-app/**/ios
apps/wrapped-app/**/android
apps/wrapped/**/logs
apps/wrapped/**/*.log
