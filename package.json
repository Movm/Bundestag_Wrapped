{
  "name": "bundestag",
  "version": "1.0.0",
  "private": true,
  "description": "Bundestag Wrapped monorepo — MCP/API backend, Python NLP analysis, and the Wrapped web frontend",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter bundestag-wrapped dev",
    "dev:mcp": "pnpm --filter bundestag-mcp dev",
    "build": "pnpm --filter bundestag-wrapped build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "contract:generate": "node scripts/generate-wrapped-contract.mjs",
    "contract:check": "node scripts/generate-wrapped-contract.mjs --check",
    "analysis:serve": "cd services/analysis && bundestag-analysis serve",
    "analysis:serve-wrapped": "cd services/analysis && bundestag-analysis serve-wrapped"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.0.10",
      "brace-expansion": "5.0.8",
      "fast-uri": "3.1.4",
      "postcss": "8.5.23",
      "tar": "7.5.22",
      "uuid": "11.1.1"
    }
  },
  "license": "AGPL-3.0-only"
}
