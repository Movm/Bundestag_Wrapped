{
  "name": "bundestag",
  "version": "1.0.0",
  "private": true,
  "description": "Bundestag Wrapped monorepo — MCP/API backend, Python NLP analysis, and the Wrapped web frontend",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter bundestag-wrapped dev",
    "preview:2026": "node apps/wrapped/scripts/prepare-dev-edition.mjs --edition 2026 --from 2026-01-01 --to 2026-10-12 --version preview-2026-10-12-context-v4 --wahlperiode 21",
    "dev:mcp": "pnpm --filter bundestag-mcp dev",
    "build": "pnpm --filter bundestag-wrapped build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "contract:generate": "node scripts/generate-wrapped-contract.mjs",
    "contract:check": "node scripts/generate-wrapped-contract.mjs --check",
    "check:registered-editions": "node scripts/check-registered-editions.mjs",
    "test:edition-validator": "node --test scripts/check-registered-editions.test.mjs",
    "analysis:serve": "cd services/analysis && bundestag-analysis serve",
    "analysis:serve-wrapped": "cd services/analysis && bundestag-analysis serve-wrapped"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "overrides": {
      "@hono/node-server": "^2.1.3",
      "body-parser": "^2.4.0",
      "brace-expansion": "^5.0.12",
      "fast-uri": "^3.1.9",
      "glob@>=9 <14.0.2": "^14.0.2",
      "minimatch@>=7 <11.0.1": "^11.0.1",
      "postcss": "8.5.23",
      "qs": "^6.16.1",
      "tar": "7.5.22",
      "undici@<7.30.1": "^7.30.1",
      "uuid": "11.1.1"
    }
  },
  "license": "AGPL-3.0-only"
}
