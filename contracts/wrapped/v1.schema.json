{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bundestag-wrapped.de/contracts/wrapped/v1.schema.json",
  "title": "Bundestag Wrapped contract v1",
  "oneOf": [
    { "$ref": "#/$defs/EditionsIndex" },
    { "$ref": "#/$defs/EditionManifest" },
    { "$ref": "#/$defs/EditionContent" },
    { "$ref": "#/$defs/WrappedData" }
  ],
  "$defs": {
    "NonEmptyString": { "type": "string", "minLength": 1 },
    "IsoDate": { "type": "string", "format": "date" },
    "IsoDateTime": { "type": "string", "format": "date-time" },
    "Count": { "type": "integer", "minimum": 0 },
    "Ratio": { "type": "number" },
    "WordCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["word", "count"],
      "properties": { "word": { "$ref": "#/$defs/NonEmptyString" }, "count": { "$ref": "#/$defs/Count" } }
    },
    "SignatureWord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["word", "ratio"],
      "properties": { "word": { "$ref": "#/$defs/NonEmptyString" }, "ratio": { "$ref": "#/$defs/Ratio" } }
    },
    "KeyTopic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["word", "count", "ratio"],
      "properties": {
        "word": { "$ref": "#/$defs/NonEmptyString" },
        "count": { "$ref": "#/$defs/Count" },
        "ratio": { "$ref": "#/$defs/Ratio" }
      }
    },
    "PartyStats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["party", "speeches", "wortbeitraege", "totalWords", "uniqueSpeakers", "topWords", "signatureWords", "keyTopics", "avgSpeechLength", "descriptiveness", "topSpeaker"],
      "properties": {
        "party": { "$ref": "#/$defs/NonEmptyString" },
        "speeches": { "$ref": "#/$defs/Count" },
        "wortbeitraege": { "$ref": "#/$defs/Count" },
        "totalWords": { "$ref": "#/$defs/Count" },
        "uniqueSpeakers": { "$ref": "#/$defs/Count" },
        "topWords": { "type": "array", "items": { "$ref": "#/$defs/WordCount" } },
        "signatureWords": { "type": "array", "items": { "$ref": "#/$defs/SignatureWord" } },
        "keyTopics": { "type": "array", "items": { "$ref": "#/$defs/KeyTopic" } },
        "avgSpeechLength": { "$ref": "#/$defs/Ratio" },
        "descriptiveness": { "$ref": "#/$defs/Ratio" },
        "topSpeaker": { "type": "object", "additionalProperties": false, "required": ["name", "speeches"], "properties": { "name": { "$ref": "#/$defs/NonEmptyString" }, "speeches": { "$ref": "#/$defs/Count" } } }
      }
    },
    "Classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive", "negative", "neutral"],
      "properties": {
        "positive": { "$ref": "#/$defs/NonEmptyString" },
        "negative": { "$ref": "#/$defs/NonEmptyString" },
        "neutral": { "$ref": "#/$defs/NonEmptyString" }
      }
    },
    "ZwischenrufStats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "positive", "negative", "neutral", "positivePercent", "negativePercent", "neutralPercent", "classification"],
      "properties": {
        "total": { "$ref": "#/$defs/Count" }, "positive": { "$ref": "#/$defs/Count" }, "negative": { "$ref": "#/$defs/Count" }, "neutral": { "$ref": "#/$defs/Count" },
        "positivePercent": { "$ref": "#/$defs/Ratio" }, "negativePercent": { "$ref": "#/$defs/Ratio" }, "neutralPercent": { "$ref": "#/$defs/Ratio" },
        "classification": { "$ref": "#/$defs/Classification" }
      }
    },
    "NamedPartyCount": {
      "type": "object", "additionalProperties": false, "required": ["name", "party", "count"],
      "properties": { "name": { "$ref": "#/$defs/NonEmptyString" }, "party": { "$ref": "#/$defs/NonEmptyString" }, "count": { "$ref": "#/$defs/Count" } }
    },
    "PartyCount": {
      "type": "object", "additionalProperties": false, "required": ["party", "count"],
      "properties": { "party": { "$ref": "#/$defs/NonEmptyString" }, "count": { "$ref": "#/$defs/Count" } }
    },
    "DramaStats": {
      "type": "object", "additionalProperties": false,
      "required": ["topZwischenrufer", "mostInterrupted", "applauseChampions", "loudestHecklers", "zwischenrufStats"],
      "properties": {
        "topZwischenrufer": { "type": "array", "items": { "$ref": "#/$defs/NamedPartyCount" } },
        "mostInterrupted": { "type": "array", "items": { "$ref": "#/$defs/NamedPartyCount" } },
        "applauseChampions": { "type": "array", "items": { "$ref": "#/$defs/PartyCount" } },
        "loudestHecklers": { "type": "array", "items": { "$ref": "#/$defs/PartyCount" } },
        "zwischenrufStats": { "$ref": "#/$defs/ZwischenrufStats" }
      }
    },
    "TopSpeaker": {
      "type": "object", "additionalProperties": false, "required": ["name", "party", "speeches"],
      "properties": { "name": { "$ref": "#/$defs/NonEmptyString" }, "party": { "$ref": "#/$defs/NonEmptyString" }, "speeches": { "$ref": "#/$defs/Count" } }
    },
    "SpeakerWords": {
      "type": "object", "additionalProperties": false, "required": ["name", "party", "totalWords", "speeches"],
      "properties": { "name": { "$ref": "#/$defs/NonEmptyString" }, "party": { "$ref": "#/$defs/NonEmptyString" }, "totalWords": { "$ref": "#/$defs/Count" }, "speeches": { "$ref": "#/$defs/Count" } }
    },
    "SpeakerAverageWords": {
      "type": "object", "additionalProperties": false, "required": ["name", "party", "avgWords", "totalWords", "speeches"],
      "properties": { "name": { "$ref": "#/$defs/NonEmptyString" }, "party": { "$ref": "#/$defs/NonEmptyString" }, "avgWords": { "$ref": "#/$defs/Ratio" }, "totalWords": { "$ref": "#/$defs/Count" }, "speeches": { "$ref": "#/$defs/Count" } }
    },
    "FunFact": {
      "type": "object", "additionalProperties": false, "required": ["emoji", "value", "label", "category"],
      "properties": { "emoji": { "$ref": "#/$defs/NonEmptyString" }, "value": { "$ref": "#/$defs/NonEmptyString" }, "label": { "$ref": "#/$defs/NonEmptyString" }, "sublabel": { "$ref": "#/$defs/NonEmptyString" }, "category": { "enum": ["general", "tone", "gender"] } }
    },
    "GenderDistribution": {
      "type": "object", "additionalProperties": false, "required": ["male", "female", "unknown", "femalePercent"],
      "properties": { "male": { "$ref": "#/$defs/Count" }, "female": { "$ref": "#/$defs/Count" }, "unknown": { "$ref": "#/$defs/Count" }, "femalePercent": { "$ref": "#/$defs/Ratio" }, "bySource": { "$ref": "#/$defs/GenderSourceCounts" } }
    },
    "GenderSource": { "enum": ["official", "override", "name_dictionary", "heuristic", "unknown"] },
    "GenderSourceCounts": {
      "type": "object", "additionalProperties": false,
      "properties": { "official": { "$ref": "#/$defs/Count" }, "override": { "$ref": "#/$defs/Count" }, "name_dictionary": { "$ref": "#/$defs/Count" }, "heuristic": { "$ref": "#/$defs/Count" }, "unknown": { "$ref": "#/$defs/Count" } }
    },
    "GenderByParty": {
      "type": "object", "additionalProperties": false, "required": ["party", "male", "female", "femaleRatio"],
      "properties": { "party": { "$ref": "#/$defs/NonEmptyString" }, "male": { "$ref": "#/$defs/Count" }, "female": { "$ref": "#/$defs/Count" }, "femaleRatio": { "$ref": "#/$defs/Ratio" } }
    },
    "GenderSpeaker": {
      "type": "object", "additionalProperties": false, "required": ["name", "party", "count"],
      "properties": { "name": { "$ref": "#/$defs/NonEmptyString" }, "party": { "$ref": "#/$defs/NonEmptyString" }, "count": { "$ref": "#/$defs/Count" } }
    },
    "InterruptionPatterns": {
      "type": "object", "additionalProperties": false, "required": ["maleInterruptions", "femaleInterruptions", "maleInterrupted", "femaleInterrupted"],
      "properties": { "maleInterruptions": { "$ref": "#/$defs/Count" }, "femaleInterruptions": { "$ref": "#/$defs/Count" }, "maleInterrupted": { "$ref": "#/$defs/Count" }, "femaleInterrupted": { "$ref": "#/$defs/Count" } }
    },
    "GenderAnalysis": {
      "type": "object", "additionalProperties": false,
      "required": ["distribution", "byParty", "topFemaleSpeakersReden", "topMaleSpeakersReden", "interruptionPatterns"],
      "properties": {
        "distribution": { "$ref": "#/$defs/GenderDistribution" }, "byParty": { "type": "array", "items": { "$ref": "#/$defs/GenderByParty" } },
        "topFemaleSpeakersReden": { "type": "array", "items": { "$ref": "#/$defs/GenderSpeaker" } }, "topMaleSpeakersReden": { "type": "array", "items": { "$ref": "#/$defs/GenderSpeaker" } },
        "topFemaleSpeakersAll": { "type": "array", "items": { "$ref": "#/$defs/GenderSpeaker" } }, "topMaleSpeakersAll": { "type": "array", "items": { "$ref": "#/$defs/GenderSpeaker" } },
        "interruptionPatterns": { "$ref": "#/$defs/InterruptionPatterns" },
        "speechLength": { "type": "object", "additionalProperties": false, "required": ["male", "female", "unknown"], "properties": { "male": { "$ref": "#/$defs/Ratio" }, "female": { "$ref": "#/$defs/Ratio" }, "unknown": { "$ref": "#/$defs/Ratio" } } },
        "academicTitles": { "type": "object", "additionalProperties": false, "required": ["male", "female"], "properties": { "male": { "$ref": "#/$defs/Ratio" }, "female": { "$ref": "#/$defs/Ratio" } } },
        "_metrics": { "type": "object", "additionalProperties": true, "description": "Extensible analysis metrics map." }
      }
    },
    "BefragungResponder": {
      "type": "object", "additionalProperties": false, "required": ["name", "party", "responses"],
      "properties": { "name": { "$ref": "#/$defs/NonEmptyString" }, "party": { "$ref": "#/$defs/NonEmptyString" }, "responses": { "$ref": "#/$defs/Count" } }
    },
    "ToneRanking": {
      "type": "object", "additionalProperties": false, "required": ["party", "score"],
      "properties": { "party": { "$ref": "#/$defs/NonEmptyString" }, "score": { "$ref": "#/$defs/Ratio" } }
    },
    "ExtendedToneScores": {
      "type": "object", "additionalProperties": false,
      "required": ["affirmative", "aggression", "labeling", "solution_focus", "collaboration", "demand_intensity", "acknowledgment", "authority", "future_orientation", "emotional_intensity", "inclusivity", "discriminatory"],
      "properties": { "affirmative": { "$ref": "#/$defs/Ratio" }, "aggression": { "$ref": "#/$defs/Ratio" }, "labeling": { "$ref": "#/$defs/Ratio" }, "solution_focus": { "$ref": "#/$defs/Ratio" }, "collaboration": { "$ref": "#/$defs/Ratio" }, "demand_intensity": { "$ref": "#/$defs/Ratio" }, "acknowledgment": { "$ref": "#/$defs/Ratio" }, "authority": { "$ref": "#/$defs/Ratio" }, "future_orientation": { "$ref": "#/$defs/Ratio" }, "emotional_intensity": { "$ref": "#/$defs/Ratio" }, "inclusivity": { "$ref": "#/$defs/Ratio" }, "discriminatory": { "$ref": "#/$defs/Ratio" } }
    },
    "PartyProfile": {
      "type": "object", "additionalProperties": false,
      "required": ["party", "category", "categoryName", "emoji", "description", "rank", "totalParties", "score", "traits", "scores"],
      "properties": { "party": { "$ref": "#/$defs/NonEmptyString" }, "category": { "$ref": "#/$defs/NonEmptyString" }, "categoryName": { "$ref": "#/$defs/NonEmptyString" }, "emoji": { "$ref": "#/$defs/NonEmptyString" }, "description": { "$ref": "#/$defs/NonEmptyString" }, "rank": { "$ref": "#/$defs/Count" }, "totalParties": { "$ref": "#/$defs/Count" }, "score": { "$ref": "#/$defs/Ratio" }, "traits": { "type": "array", "items": { "$ref": "#/$defs/NonEmptyString" } }, "scores": { "$ref": "#/$defs/ExtendedToneScores" }, "archetype": { "$ref": "#/$defs/NonEmptyString" }, "archetypeName": { "$ref": "#/$defs/NonEmptyString" } }
    },
    "ToneParty": {
      "type": "object", "additionalProperties": false, "required": ["party", "scores", "topAffirmative", "topCritical", "topAggressive", "topLabeling", "topSolution", "topProblem", "topCollaborative", "topConfrontational", "topDemanding", "topAcknowledging"],
      "properties": { "party": { "$ref": "#/$defs/NonEmptyString" }, "scores": { "type": "object", "additionalProperties": { "$ref": "#/$defs/Ratio" } }, "topAffirmative": { "type": "array", "items": { "$ref": "#/$defs/WordCount" } }, "topCritical": { "type": "array", "items": { "$ref": "#/$defs/WordCount" } }, "topAggressive": { "type": "array", "items": { "$ref": "#/$defs/WordCount" } }, "topLabeling": { "type": "array", "items": { "$ref": "#/$defs/WordCount" } }, "topSolution": { "type": "array", "items": { "$ref": "#/$defs/WordCount" } }, "topProblem": { "type": "array", "items": { "$ref": "#/$defs/WordCount" } }, "topCollaborative": { "type": "array", "items": { "$ref": "#/$defs/WordCount" } }, "topConfrontational": { "type": "array", "items": { "$ref": "#/$defs/WordCount" } }, "topDemanding": { "type": "array", "items": { "$ref": "#/$defs/WordCount" } }, "topAcknowledging": { "type": "array", "items": { "$ref": "#/$defs/WordCount" } } }
    },
    "ToneRankings": {
      "type": "object", "additionalProperties": false, "required": ["affirmative", "aggression", "labeling", "solutionFocus", "collaboration", "demandIntensity", "acknowledgment"],
      "properties": { "affirmative": { "type": "array", "items": { "$ref": "#/$defs/ToneRanking" } }, "aggression": { "type": "array", "items": { "$ref": "#/$defs/ToneRanking" } }, "labeling": { "type": "array", "items": { "$ref": "#/$defs/ToneRanking" } }, "solutionFocus": { "type": "array", "items": { "$ref": "#/$defs/ToneRanking" } }, "collaboration": { "type": "array", "items": { "$ref": "#/$defs/ToneRanking" } }, "demandIntensity": { "type": "array", "items": { "$ref": "#/$defs/ToneRanking" } }, "acknowledgment": { "type": "array", "items": { "$ref": "#/$defs/ToneRanking" } }, "authority": { "type": "array", "items": { "$ref": "#/$defs/ToneRanking" } }, "futureOrientation": { "type": "array", "items": { "$ref": "#/$defs/ToneRanking" } }, "emotionalIntensity": { "type": "array", "items": { "$ref": "#/$defs/ToneRanking" } }, "inclusivity": { "type": "array", "items": { "$ref": "#/$defs/ToneRanking" } }, "discriminatory": { "type": "array", "items": { "$ref": "#/$defs/ToneRanking" } }, "discriminatoryCounts": { "type": "array", "items": { "$ref": "#/$defs/PartyCount" } } }
    },
    "ToneAnalysis": {
      "type": "object", "additionalProperties": false, "required": ["parties", "partyProfiles", "rankings"],
      "properties": { "parties": { "type": "array", "items": { "$ref": "#/$defs/ToneParty" } }, "partyProfiles": { "type": "object", "additionalProperties": { "$ref": "#/$defs/PartyProfile" } }, "rankings": { "$ref": "#/$defs/ToneRankings" } }
    },
    "TopicScore": {
      "type": "object", "additionalProperties": false, "required": ["topic", "score", "rank"],
      "properties": { "topic": { "$ref": "#/$defs/NonEmptyString" }, "score": { "$ref": "#/$defs/Ratio" }, "rank": { "$ref": "#/$defs/Count" } }
    },
    "TopicSpeaker": {
      "type": "object", "additionalProperties": false, "required": ["name", "party", "vsAverage"],
      "properties": { "name": { "$ref": "#/$defs/NonEmptyString" }, "party": { "$ref": "#/$defs/NonEmptyString" }, "vsAverage": { "$ref": "#/$defs/Ratio" } }
    },
    "TopicWord": {
      "type": "object", "additionalProperties": false, "required": ["word", "count"],
      "properties": { "word": { "$ref": "#/$defs/NonEmptyString" }, "count": { "$ref": "#/$defs/Count" } }
    },
    "TopicAnalysis": {
      "type": "object", "additionalProperties": false, "required": ["byParty", "overall", "topTopics"],
      "properties": { "byParty": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/Ratio" } } }, "overall": { "type": "object", "additionalProperties": { "$ref": "#/$defs/Ratio" } }, "topTopics": { "type": "array", "items": { "$ref": "#/$defs/TopicScore" } }, "topWords": { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/TopicWord" } } }, "topSpeakers": { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/TopicSpeaker" } } } }
    },
    "ComparisonPeriod": {
      "type": "object", "additionalProperties": false, "required": ["editionId", "start", "end"],
      "properties": { "editionId": { "$ref": "#/$defs/NonEmptyString" }, "start": { "$ref": "#/$defs/IsoDate" }, "end": { "$ref": "#/$defs/IsoDate" } }
    },
    "RankMovement": {
      "type": "object", "additionalProperties": false, "required": ["label", "currentRank", "previousRank", "rankChange"],
      "properties": { "label": { "$ref": "#/$defs/NonEmptyString" }, "currentRank": { "$ref": "#/$defs/Count" }, "previousRank": { "anyOf": [{ "$ref": "#/$defs/Count" }, { "type": "null" }] }, "rankChange": { "type": "integer" } }
    },
    "MentionSpeaker": {
      "type": "object", "additionalProperties": false, "required": ["name", "party", "count", "date", "quote"],
      "properties": { "name": { "$ref": "#/$defs/NonEmptyString" }, "party": { "$ref": "#/$defs/NonEmptyString" }, "count": { "$ref": "#/$defs/Count" }, "date": { "$ref": "#/$defs/IsoDate" }, "quote": { "$ref": "#/$defs/NonEmptyString" } }
    },
    "GenerationWord": { "type": "object", "additionalProperties": false, "required": ["word", "ratio", "zScore"], "properties": { "word": { "$ref": "#/$defs/NonEmptyString" }, "count": { "type": "integer", "minimum": 1 }, "ratio": { "type": "number", "minimum": 0 }, "zScore": { "type": "number" } } },
    "GenerationSpeaker": { "type": "object", "additionalProperties": false, "required": ["name", "party", "birthYear", "speeches"], "properties": { "name": { "$ref": "#/$defs/NonEmptyString" }, "party": { "$ref": "#/$defs/NonEmptyString" }, "birthYear": { "type": "integer", "minimum": 1900 }, "speeches": { "type": "integer", "minimum": 1 } } },
    "GenerationComparison": { "type": "object", "additionalProperties": false, "description": "Gen Z MPs at the lectern against older MPs; words compared at the same party mix.", "required": ["cohort", "bornFrom", "speakerCount", "totalSpeakers", "unknownSpeakers", "parties", "speakers", "speechesPerSpeaker", "olderSpeechesPerSpeaker", "words", "fewerWords"], "properties": { "cohort": { "const": "genz" }, "bornFrom": { "type": "integer", "minimum": 1900 }, "speakerCount": { "type": "integer", "minimum": 1 }, "totalSpeakers": { "type": "integer", "minimum": 1 }, "unknownSpeakers": { "type": "integer", "minimum": 0 }, "parties": { "type": "array", "items": { "$ref": "#/$defs/PartyCount" } }, "speakers": { "type": "array", "items": { "$ref": "#/$defs/GenerationSpeaker" } }, "speechesPerSpeaker": { "type": "number", "minimum": 0 }, "olderSpeechesPerSpeaker": { "type": "number", "minimum": 0 }, "words": { "type": "array", "items": { "$ref": "#/$defs/GenerationWord" } }, "fewerWords": { "type": "array", "items": { "$ref": "#/$defs/GenerationWord" } } } },
    "Mention": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "count", "speakers"],
      "properties": { "id": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "label": { "$ref": "#/$defs/NonEmptyString" }, "count": { "$ref": "#/$defs/Count" }, "speakers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/MentionSpeaker" } }, "background": { "type": "array", "items": { "$ref": "#/$defs/NonEmptyString" } }, "source": { "$ref": "#/$defs/NonEmptyString" }, "headline": { "$ref": "#/$defs/NonEmptyString" }, "subtitle": { "$ref": "#/$defs/NonEmptyString" } }
    },
    "YouthWordSpeaker": {
      "type": "object", "additionalProperties": false, "required": ["name", "party", "count"],
      "properties": { "name": { "$ref": "#/$defs/NonEmptyString" }, "party": { "$ref": "#/$defs/NonEmptyString" }, "count": { "$ref": "#/$defs/Count" } }
    },
    "YouthWordCount": {
      "type": "object", "additionalProperties": false, "required": ["word", "count", "previousCount", "change"],
      "properties": { "word": { "$ref": "#/$defs/NonEmptyString" }, "count": { "$ref": "#/$defs/Count" }, "previousCount": { "$ref": "#/$defs/Count" }, "change": { "type": "integer" }, "winnerYear": { "$ref": "#/$defs/Count" }, "speakers": { "type": "array", "items": { "$ref": "#/$defs/YouthWordSpeaker" } } }
    },
    "YouthLanguageAnalysis": {
      "type": "object", "additionalProperties": false, "required": ["lexiconVersion", "words", "byParty", "bySpeaker"],
      "properties": { "lexiconVersion": { "$ref": "#/$defs/NonEmptyString" }, "words": { "type": "array", "items": { "$ref": "#/$defs/YouthWordCount" } }, "byParty": { "type": "array", "items": { "$ref": "#/$defs/PartyCount" } }, "bySpeaker": { "type": "array", "items": { "$ref": "#/$defs/NamedPartyCount" } } }
    },
    "SignatureWordMovement": {
      "type": "object", "additionalProperties": false, "required": ["word", "currentRank", "previousRank"],
      "properties": { "word": { "$ref": "#/$defs/NonEmptyString" }, "currentRank": { "anyOf": [{ "$ref": "#/$defs/Count" }, { "type": "null" }] }, "previousRank": { "anyOf": [{ "$ref": "#/$defs/Count" }, { "type": "null" }] } }
    },
    "PartySignatureWordMovements": {
      "type": "object", "additionalProperties": false, "required": ["party", "risers", "fallers"],
      "properties": { "party": { "$ref": "#/$defs/NonEmptyString" }, "risers": { "type": "array", "items": { "$ref": "#/$defs/SignatureWordMovement" } }, "fallers": { "type": "array", "items": { "$ref": "#/$defs/SignatureWordMovement" } } }
    },
    "YearOverYearAnalysis": {
      "type": "object", "additionalProperties": false, "required": ["baseline", "topics", "words", "signatureWords", "youthLanguage"],
      "properties": { "baseline": { "$ref": "#/$defs/ComparisonPeriod" }, "topics": { "type": "array", "items": { "$ref": "#/$defs/RankMovement" } }, "words": { "type": "array", "items": { "$ref": "#/$defs/RankMovement" } }, "signatureWords": { "type": "array", "items": { "$ref": "#/$defs/PartySignatureWordMovements" } }, "youthLanguage": { "$ref": "#/$defs/YouthLanguageAnalysis" } }
    },
    "QuizQuestion": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "question", "options", "correctAnswer", "explanation"],
      "properties": { "id": { "$ref": "#/$defs/NonEmptyString" }, "type": { "enum": ["guess-party", "prediction", "emoji-quiz"] }, "question": { "$ref": "#/$defs/NonEmptyString" }, "word": { "$ref": "#/$defs/NonEmptyString" }, "party": { "$ref": "#/$defs/NonEmptyString" }, "options": { "type": "array", "items": { "$ref": "#/$defs/NonEmptyString" } }, "correctAnswer": { "$ref": "#/$defs/NonEmptyString" }, "explanation": { "$ref": "#/$defs/NonEmptyString" }, "ratio": { "$ref": "#/$defs/Ratio" }, "swiftie": { "$ref": "#/$defs/NamedParty" }, "decoys": { "type": "array", "items": { "$ref": "#/$defs/NamedParty" } }, "layout": { "enum": ["stack", "tiles", "fan", "gap", "quadrants", "stickers", "swipe"] }, "gapSentence": { "type": "string", "pattern": "\\{answer\\}" } }
    },
    "NamedParty": { "type": "object", "additionalProperties": false, "required": ["name", "party"], "properties": { "name": { "$ref": "#/$defs/NonEmptyString" }, "party": { "$ref": "#/$defs/NonEmptyString" } } },
    "WrappedMetadata": {
      "type": "object", "additionalProperties": false, "required": ["generatedAt", "totalSpeeches", "redenCount", "wortbeitraegeCount", "totalWords", "partyCount", "speakerCount", "wahlperiode", "sitzungen"],
      "properties": { "generatedAt": { "$ref": "#/$defs/IsoDateTime" }, "totalSpeeches": { "$ref": "#/$defs/Count" }, "redenCount": { "$ref": "#/$defs/Count" }, "wortbeitraegeCount": { "$ref": "#/$defs/Count" }, "totalWords": { "$ref": "#/$defs/Count" }, "partyCount": { "$ref": "#/$defs/Count" }, "speakerCount": { "$ref": "#/$defs/Count" }, "wahlperiode": { "$ref": "#/$defs/Count" }, "sitzungen": { "$ref": "#/$defs/Count" } }
    },
    "WrappedData": {
      "type": "object", "additionalProperties": false,
      "required": ["metadata", "parties", "drama", "topSpeakers", "topBefragungResponders", "topSpeakersByWords", "topSpeakersByAvgWords", "hotTopics", "toneAnalysis", "topicAnalysis", "funFacts", "genderAnalysis", "moinSpeakers", "topQuestionAskers"],
      "properties": { "metadata": { "$ref": "#/$defs/WrappedMetadata" }, "parties": { "type": "array", "items": { "$ref": "#/$defs/PartyStats" } }, "drama": { "$ref": "#/$defs/DramaStats" }, "topSpeakers": { "type": "array", "items": { "$ref": "#/$defs/TopSpeaker" } }, "topBefragungResponders": { "type": "array", "items": { "$ref": "#/$defs/BefragungResponder" } }, "topSpeakersByWords": { "type": "array", "items": { "$ref": "#/$defs/SpeakerWords" } }, "topSpeakersByAvgWords": { "type": "array", "items": { "$ref": "#/$defs/SpeakerAverageWords" } }, "hotTopics": { "type": "array", "items": { "$ref": "#/$defs/NonEmptyString" } }, "quizQuestions": { "type": "array", "items": { "$ref": "#/$defs/QuizQuestion" } }, "toneAnalysis": { "anyOf": [{ "$ref": "#/$defs/ToneAnalysis" }, { "type": "null" }] }, "topicAnalysis": { "anyOf": [{ "$ref": "#/$defs/TopicAnalysis" }, { "type": "null" }] }, "funFacts": { "type": "array", "items": { "$ref": "#/$defs/FunFact" } }, "genderAnalysis": { "anyOf": [{ "$ref": "#/$defs/GenderAnalysis" }, { "type": "null" }] }, "moinSpeakers": { "type": "array", "items": { "$ref": "#/$defs/NamedPartyCount" } }, "topQuestionAskers": { "type": "array", "items": { "$ref": "#/$defs/NamedPartyCount" } }, "yearOverYear": { "$ref": "#/$defs/YearOverYearAnalysis" }, "mentions": { "type": "array", "items": { "$ref": "#/$defs/Mention" } }, "generations": { "$ref": "#/$defs/GenerationComparison" } }
    },
    "SpeakerIndexAsset": {
      "type": "object",
      "additionalProperties": true,
      "required": ["speakers"],
      "properties": {
        "speakers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["slug", "name", "party", "speeches", "wortbeitraege", "words"],
            "properties": {
              "slug": { "$ref": "#/$defs/NonEmptyString" },
              "name": { "$ref": "#/$defs/NonEmptyString" },
              "party": { "$ref": "#/$defs/NonEmptyString" },
              "speeches": { "$ref": "#/$defs/Count" },
              "wortbeitraege": { "$ref": "#/$defs/Count" },
              "words": { "$ref": "#/$defs/Count" }
            }
          }
        }
      }
    },
    "SpeakerWrappedAsset": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "party", "slug", "speeches", "wortbeitraege", "totalWords", "avgWords", "minWords", "maxWords", "rankings", "drama", "words", "comparison", "funFacts"],
      "properties": {
        "name": { "$ref": "#/$defs/NonEmptyString" },
        "party": { "$ref": "#/$defs/NonEmptyString" },
        "slug": { "$ref": "#/$defs/NonEmptyString" },
        "speeches": { "$ref": "#/$defs/Count" },
        "wortbeitraege": { "$ref": "#/$defs/Count" },
        "totalWords": { "$ref": "#/$defs/Count" },
        "avgWords": { "$ref": "#/$defs/Ratio" },
        "minWords": { "$ref": "#/$defs/Count" },
        "maxWords": { "$ref": "#/$defs/Count" },
        "gender": { "enum": ["male", "female", "unknown"] },
        "genderSource": { "$ref": "#/$defs/GenderSource" },
        "rankings": { "type": "object" },
        "drama": { "type": "object" },
        "words": { "type": "object" },
        "comparison": { "type": "object" },
        "funFacts": { "type": "array" }
      }
    },
    "SpeechesAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speeches"],
      "properties": {
        "speeches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["speaker", "party", "category", "words", "text"],
            "properties": {
              "speaker": { "$ref": "#/$defs/NonEmptyString" },
              "party": { "$ref": "#/$defs/NonEmptyString" },
              "category": { "enum": ["rede", "wortbeitrag"] },
              "words": { "$ref": "#/$defs/Count" },
              "text": { "type": "string" }
            }
          }
        }
      }
    },
    "PartyWord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["word", "count"],
      "properties": {
        "word": { "$ref": "#/$defs/NonEmptyString" },
        "count": { "$ref": "#/$defs/Count" }
      }
    },
    "WordsAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parties"],
      "properties": {
        "parties": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["party", "words"],
            "properties": {
              "party": { "$ref": "#/$defs/NonEmptyString" },
              "words": { "type": "array", "items": { "$ref": "#/$defs/PartyWord" } }
            }
          }
        }
      }
    },
    "WordRankingsAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parties"],
      "properties": {
        "parties": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["party", "signatureWords"],
            "properties": {
              "party": { "$ref": "#/$defs/NonEmptyString" },
              "signatureWords": { "type": "array", "items": { "$ref": "#/$defs/SignatureWord" } }
            }
          }
        }
      }
    },
    "TopicRankingsAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topics"],
      "properties": { "topics": { "type": "array", "items": { "$ref": "#/$defs/NonEmptyString" } } }
    },
    "MatchWord": { "type": "object", "additionalProperties": false, "required": ["word", "topic"], "properties": { "word": { "$ref": "#/$defs/NonEmptyString" }, "topic": { "type": ["string", "null"], "description": "Topic id the word belongs to, or null when it carries no topic." } } },
    "MatchAnimal": { "type": "object", "additionalProperties": false, "required": ["id", "emoji", "name", "count"], "properties": { "id": { "$ref": "#/$defs/NonEmptyString" }, "emoji": { "$ref": "#/$defs/NonEmptyString" }, "name": { "$ref": "#/$defs/NonEmptyString" }, "count": { "$ref": "#/$defs/Count" } } },
    "MatchMp": { "type": "object", "additionalProperties": false, "required": ["slug", "name", "party", "animal", "topics", "words"], "properties": { "slug": { "$ref": "#/$defs/NonEmptyString" }, "name": { "$ref": "#/$defs/NonEmptyString" }, "party": { "type": "integer", "minimum": 0, "description": "Index into MatchAsset.parties." }, "animal": { "type": "integer", "minimum": -1, "description": "Index into MatchAsset.animals, -1 when the MP has no spirit animal." }, "topics": { "type": "array", "items": { "$ref": "#/$defs/Count" }, "description": "Per topic, aligned with MatchAsset.topics: topic score per 1000 words times 100, rounded." }, "words": { "type": "array", "items": { "$ref": "#/$defs/Count" }, "description": "Per candidate word, aligned with MatchAsset.words: smoothed rate ratio versus the four-party corpus times 10, rounded." } } },
    "MatchAsset": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "parties", "topics", "words", "animals", "mps"], "properties": { "schemaVersion": { "const": 1 }, "parties": { "type": "array", "items": { "$ref": "#/$defs/NonEmptyString" } }, "topics": { "type": "array", "items": { "$ref": "#/$defs/NonEmptyString" } }, "words": { "type": "array", "items": { "$ref": "#/$defs/MatchWord" } }, "animals": { "type": "array", "items": { "$ref": "#/$defs/MatchAnimal" } }, "mps": { "type": "array", "items": { "$ref": "#/$defs/MatchMp" } } } },
    "EditionStatus": { "enum": ["draft", "preview", "frozen", "published", "superseded"] },
    "EditionPeriod": { "type": "object", "additionalProperties": false, "required": ["start", "end", "timezone", "wahlperioden"], "properties": { "start": { "$ref": "#/$defs/IsoDate" }, "end": { "$ref": "#/$defs/IsoDate" }, "timezone": { "const": "Europe/Berlin" }, "wahlperioden": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } } } },
    "Coverage": { "type": "object", "additionalProperties": false, "required": ["protocolCount", "firstProtocolDate", "lastProtocolDate", "complete"], "properties": { "protocolCount": { "$ref": "#/$defs/Count" }, "firstProtocolDate": { "$ref": "#/$defs/IsoDate" }, "lastProtocolDate": { "$ref": "#/$defs/IsoDate" }, "complete": { "type": "boolean" } } },
    "EditionAssets": { "type": "object", "additionalProperties": false, "required": ["wrapped", "speakerIndex", "speakersBase", "speeches", "words", "wordRankings", "topicRankings"], "properties": { "wrapped": { "$ref": "#/$defs/NonEmptyString" }, "speakerIndex": { "$ref": "#/$defs/NonEmptyString" }, "speakersBase": { "$ref": "#/$defs/NonEmptyString" }, "speeches": { "$ref": "#/$defs/NonEmptyString" }, "words": { "$ref": "#/$defs/NonEmptyString" }, "wordRankings": { "$ref": "#/$defs/NonEmptyString" }, "topicRankings": { "$ref": "#/$defs/NonEmptyString" }, "match": { "$ref": "#/$defs/NonEmptyString", "description": "Optional compact Perfect Match asset; editions before 2026 do not have one." } } },
    "EditionManifest": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "editionId", "year", "title", "status", "period", "dataVersion", "generatedAt", "coverage", "assets", "content", "checksums"], "properties": { "schemaVersion": { "const": 1 }, "editionId": { "$ref": "#/$defs/NonEmptyString" }, "year": { "type": "integer", "minimum": 2000 }, "title": { "$ref": "#/$defs/NonEmptyString" }, "status": { "$ref": "#/$defs/EditionStatus" }, "period": { "$ref": "#/$defs/EditionPeriod" }, "dataVersion": { "$ref": "#/$defs/NonEmptyString" }, "generatedAt": { "$ref": "#/$defs/IsoDateTime" }, "coverage": { "$ref": "#/$defs/Coverage" }, "assets": { "$ref": "#/$defs/EditionAssets" }, "content": { "$ref": "#/$defs/NonEmptyString" }, "checksums": { "$ref": "#/$defs/NonEmptyString" } } },
    "EditionQuizTextOverrides": { "type": "object", "additionalProperties": false, "properties": { "question": { "$ref": "#/$defs/NonEmptyString" }, "explanation": { "$ref": "#/$defs/NonEmptyString" }, "layout": { "enum": ["stack", "tiles", "fan", "gap", "quadrants", "stickers", "swipe"] }, "gapSentence": { "type": "string", "pattern": "\\{answer\\}" } } },
    "EditionQuizGroup": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "type": "string", "pattern": "^quiz-[a-z0-9-]+$" }, "question": { "$ref": "#/$defs/QuizQuestion" }, "text": { "$ref": "#/$defs/EditionQuizTextOverrides" }, "party": { "$ref": "#/$defs/NonEmptyString", "description": "Asks a party question (quiz-signature) about this party instead of the data-picked one." } } },
    "EditionQuizConfiguration": { "type": "object", "additionalProperties": false, "required": ["version", "groups"], "properties": { "version": { "const": 1 }, "groups": { "type": "array", "items": { "$ref": "#/$defs/EditionQuizGroup" } } } },
    "EditionContent": { "type": "object", "additionalProperties": false, "required": ["editionId", "year"], "properties": { "editionId": { "$ref": "#/$defs/NonEmptyString" }, "year": { "type": "integer", "minimum": 2000 }, "quiz": { "$ref": "#/$defs/EditionQuizConfiguration" } } },
    "EditionSummary": { "type": "object", "additionalProperties": false, "required": ["id", "year", "status", "manifestUrl"], "properties": { "id": { "$ref": "#/$defs/NonEmptyString" }, "year": { "type": "integer", "minimum": 2000 }, "status": { "$ref": "#/$defs/EditionStatus" }, "manifestUrl": { "$ref": "#/$defs/NonEmptyString" }, "access": { "enum": ["basic-auth"] } } },
    "EditionsIndex": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "currentEdition", "editions"], "properties": { "schemaVersion": { "const": 1 }, "currentEdition": { "$ref": "#/$defs/NonEmptyString" }, "editions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/EditionSummary" } } } }
  }
}
