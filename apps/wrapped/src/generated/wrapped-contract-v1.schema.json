        "topAffirmative",
        "topCritical",
        "topAggressive",
        "topLabeling",
        "topSolution",
        "topProblem",
        "topCollaborative",
        "topConfrontational",
        "topDemanding",
        "topAcknowledging"
      ],
      "properties": {
        "party": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "scores": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Ratio"
          }
        },
        "topAffirmative": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WordCount"
          }
        },
        "topCritical": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WordCount"
          }
        },
        "topAggressive": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WordCount"
          }
        },
        "topLabeling": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WordCount"
          }
        },
        "topSolution": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WordCount"
          }
        },
        "topProblem": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WordCount"
          }
        },
        "topCollaborative": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WordCount"
          }
        },
        "topConfrontational": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WordCount"
          }
        },
        "topDemanding": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WordCount"
          }
        },
        "topAcknowledging": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WordCount"
          }
        }
      }
    },
    "ToneRankings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "affirmative",
        "aggression",
        "labeling",
        "solutionFocus",
        "collaboration",
        "demandIntensity",
        "acknowledgment"
      ],
      "properties": {
        "affirmative": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToneRanking"
          }
        },
        "aggression": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToneRanking"
          }
        },
        "labeling": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToneRanking"
          }
        },
        "solutionFocus": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToneRanking"
          }
        },
        "collaboration": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToneRanking"
          }
        },
        "demandIntensity": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToneRanking"
          }
        },
        "acknowledgment": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToneRanking"
          }
        },
        "authority": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToneRanking"
          }
        },
        "futureOrientation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToneRanking"
          }
        },
        "emotionalIntensity": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToneRanking"
          }
        },
        "inclusivity": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToneRanking"
          }
        },
        "discriminatory": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToneRanking"
          }
        },
        "discriminatoryCounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PartyCount"
          }
        }
      }
    },
    "ToneAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parties",
        "partyProfiles",
        "rankings"
      ],
      "properties": {
        "parties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToneParty"
          }
        },
        "partyProfiles": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/PartyProfile"
          }
        },
        "rankings": {
          "$ref": "#/$defs/ToneRankings"
        }
      }
    },
    "TopicScore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic",
        "score",
        "rank"
      ],
      "properties": {
        "topic": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "score": {
          "$ref": "#/$defs/Ratio"
        },
        "rank": {
          "$ref": "#/$defs/Count"
        }
      }
    },
    "TopicAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byParty",
        "overall",
        "topTopics"
      ],
      "properties": {
        "byParty": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/Ratio"
            }
          }
        },
        "overall": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Ratio"
          }
        },
        "topTopics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TopicScore"
          }
        }
      }
    },
    "QuizQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "question",
        "options",
        "correctAnswer",
        "explanation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "type": {
          "enum": [
            "guess-party",
            "prediction",
            "emoji-quiz"
          ]
