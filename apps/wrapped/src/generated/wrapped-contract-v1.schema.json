        "explanation": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "ratio": {
          "$ref": "#/$defs/Ratio"
        },
        "swiftie": {
          "$ref": "#/$defs/NamedParty"
        },
        "decoys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NamedParty"
          }
        }
      }
    },
    "NamedParty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "party"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "party": {
          "$ref": "#/$defs/NonEmptyString"
        }
      }
    },
    "WrappedMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generatedAt",
        "totalSpeeches",
        "redenCount",
        "wortbeitraegeCount",
        "totalWords",
        "partyCount",
        "speakerCount",
        "wahlperiode",
        "sitzungen"
      ],
      "properties": {
        "generatedAt": {
          "$ref": "#/$defs/IsoDateTime"
        },
        "totalSpeeches": {
          "$ref": "#/$defs/Count"
        },
        "redenCount": {
          "$ref": "#/$defs/Count"
        },
        "wortbeitraegeCount": {
          "$ref": "#/$defs/Count"
        },
        "totalWords": {
          "$ref": "#/$defs/Count"
        },
        "partyCount": {
          "$ref": "#/$defs/Count"
        },
        "speakerCount": {
          "$ref": "#/$defs/Count"
        },
        "wahlperiode": {
          "$ref": "#/$defs/Count"
        },
        "sitzungen": {
          "$ref": "#/$defs/Count"
        }
      }
    },
    "WrappedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata",
        "parties",
        "drama",
        "topSpeakers",
        "topBefragungResponders",
        "topSpeakersByWords",
        "topSpeakersByAvgWords",
        "hotTopics",
        "toneAnalysis",
        "topicAnalysis",
        "funFacts",
        "genderAnalysis",
        "moinSpeakers",
        "topQuestionAskers"
      ],
      "properties": {
        "metadata": {
          "$ref": "#/$defs/WrappedMetadata"
        },
        "parties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PartyStats"
          }
        },
        "drama": {
          "$ref": "#/$defs/DramaStats"
        },
        "topSpeakers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TopSpeaker"
          }
        },
        "topBefragungResponders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BefragungResponder"
          }
        },
        "topSpeakersByWords": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SpeakerWords"
          }
        },
        "topSpeakersByAvgWords": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SpeakerAverageWords"
          }
        },
        "hotTopics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NonEmptyString"
          }
        },
        "quizQuestions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QuizQuestion"
          }
        },
        "toneAnalysis": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToneAnalysis"
            },
            {
              "type": "null"
            }
          ]
        },
        "topicAnalysis": {
          "anyOf": [
            {
              "$ref": "#/$defs/TopicAnalysis"
            },
            {
              "type": "null"
            }
          ]
        },
        "funFacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FunFact"
          }
        },
        "genderAnalysis": {
          "anyOf": [
            {
              "$ref": "#/$defs/GenderAnalysis"
            },
            {
              "type": "null"
            }
          ]
        },
        "moinSpeakers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NamedPartyCount"
          }
        },
        "topQuestionAskers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NamedPartyCount"
          }
        }
      }
    },
    "EditionStatus": {
      "enum": [
        "draft",
        "preview",
        "frozen",
        "published",
        "superseded"
      ]
    },
    "EditionPeriod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "timezone",
        "wahlperioden"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/IsoDate"
        },
        "end": {
          "$ref": "#/$defs/IsoDate"
        },
        "timezone": {
          "const": "Europe/Berlin"
        },
        "wahlperioden": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "Coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolCount",
        "firstProtocolDate",
        "lastProtocolDate",
        "complete"
      ],
      "properties": {
        "protocolCount": {
          "$ref": "#/$defs/Count"
        },
        "firstProtocolDate": {
          "$ref": "#/$defs/IsoDate"
        },
        "lastProtocolDate": {
          "$ref": "#/$defs/IsoDate"
        },
        "complete": {
          "type": "boolean"
        }
      }
    },
    "EditionAssets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wrapped",
        "speakerIndex",
        "speakersBase",
        "speeches",
        "words",
        "wordRankings",
        "topicRankings"
      ],
      "properties": {
        "wrapped": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "speakerIndex": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "speakersBase": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "speeches": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "words": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "wordRankings": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "topicRankings": {
          "$ref": "#/$defs/NonEmptyString"
        }
      }
    },
    "EditionManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "editionId",
        "year",
        "title",
        "status",
        "period",
        "dataVersion",
        "generatedAt",
        "coverage",
        "assets",
        "content",
        "checksums"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "editionId": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "year": {
          "type": "integer",
          "minimum": 2000
        },
        "title": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "status": {
          "$ref": "#/$defs/EditionStatus"
        },
        "period": {
          "$ref": "#/$defs/EditionPeriod"
        },
        "dataVersion": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "generatedAt": {
          "$ref": "#/$defs/IsoDateTime"
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "assets": {
          "$ref": "#/$defs/EditionAssets"
        },
        "content": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "checksums": {
          "$ref": "#/$defs/NonEmptyString"
        }
      }
    },
    "EditionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "year",
        "status",
        "manifestUrl"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "year": {
          "type": "integer",
          "minimum": 2000
        },
        "status": {
          "$ref": "#/$defs/EditionStatus"
        },
        "manifestUrl": {
          "$ref": "#/$defs/NonEmptyString"
        }
      }
    },
    "EditionsIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "currentEdition",
        "editions"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "currentEdition": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "editions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/EditionSummary"
          }
        }
      }
    }
  }
}
