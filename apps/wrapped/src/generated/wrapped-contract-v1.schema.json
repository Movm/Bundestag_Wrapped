{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bundestag-wrapped.de/contracts/wrapped/v1.schema.json",
  "title": "Bundestag Wrapped contract v1",
  "oneOf": [
    {
      "$ref": "#/$defs/EditionsIndex"
    },
    {
      "$ref": "#/$defs/EditionManifest"
    },
    {
      "$ref": "#/$defs/WrappedData"
    }
  ],
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "IsoDate": {
      "type": "string",
      "format": "date"
    },
    "IsoDateTime": {
      "type": "string",
      "format": "date-time"
    },
    "Count": {
      "type": "integer",
      "minimum": 0
    },
    "Ratio": {
      "type": "number"
    },
    "WordCount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "word",
        "count"
      ],
      "properties": {
        "word": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "count": {
          "$ref": "#/$defs/Count"
        }
      }
    },
    "SignatureWord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "word",
        "ratio"
      ],
      "properties": {
        "word": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "ratio": {
          "$ref": "#/$defs/Ratio"
        }
      }
    },
    "KeyTopic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "word",
        "count",
        "ratio"
      ],
      "properties": {
        "word": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "count": {
          "$ref": "#/$defs/Count"
        },
        "ratio": {
          "$ref": "#/$defs/Ratio"
        }
      }
    },
    "PartyStats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "party",
        "speeches",
        "wortbeitraege",
        "totalWords",
        "uniqueSpeakers",
        "topWords",
        "signatureWords",
        "keyTopics",
        "avgSpeechLength",
        "descriptiveness",
        "topSpeaker"
      ],
      "properties": {
        "party": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "speeches": {
          "$ref": "#/$defs/Count"
        },
        "wortbeitraege": {
          "$ref": "#/$defs/Count"
        },
        "totalWords": {
          "$ref": "#/$defs/Count"
        },
        "uniqueSpeakers": {
          "$ref": "#/$defs/Count"
        },
        "topWords": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WordCount"
          }
        },
        "signatureWords": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SignatureWord"
          }
        },
        "keyTopics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/KeyTopic"
          }
        },
        "avgSpeechLength": {
          "$ref": "#/$defs/Ratio"
        },
        "descriptiveness": {
          "$ref": "#/$defs/Ratio"
        },
        "topSpeaker": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "speeches"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/NonEmptyString"
            },
            "speeches": {
              "$ref": "#/$defs/Count"
            }
          }
        }
      }
    },
    "Classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positive",
        "negative",
        "neutral"
      ],
      "properties": {
        "positive": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "negative": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "neutral": {
          "$ref": "#/$defs/NonEmptyString"
        }
      }
    },
    "ZwischenrufStats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "positive",
        "negative",
        "neutral",
        "positivePercent",
        "negativePercent",
        "neutralPercent",
        "classification"
      ],
      "properties": {
        "total": {
          "$ref": "#/$defs/Count"
        },
        "positive": {
          "$ref": "#/$defs/Count"
        },
        "negative": {
          "$ref": "#/$defs/Count"
        },
        "neutral": {
          "$ref": "#/$defs/Count"
        },
        "positivePercent": {
          "$ref": "#/$defs/Ratio"
        },
        "negativePercent": {
          "$ref": "#/$defs/Ratio"
        },
        "neutralPercent": {
          "$ref": "#/$defs/Ratio"
        },
        "classification": {
          "$ref": "#/$defs/Classification"
        }
      }
    },
    "NamedPartyCount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "party",
        "count"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "party": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "count": {
          "$ref": "#/$defs/Count"
        }
      }
    },
    "PartyCount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "party",
        "count"
      ],
      "properties": {
        "party": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "count": {
          "$ref": "#/$defs/Count"
        }
      }
    },
    "DramaStats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topZwischenrufer",
        "mostInterrupted",
        "applauseChampions",
        "loudestHecklers",
        "zwischenrufStats"
      ],
      "properties": {
        "topZwischenrufer": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NamedPartyCount"
          }
        },
        "mostInterrupted": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NamedPartyCount"
          }
        },
        "applauseChampions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PartyCount"
          }
        },
        "loudestHecklers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PartyCount"
          }
        },
        "zwischenrufStats": {
          "$ref": "#/$defs/ZwischenrufStats"
        }
      }
    },
    "TopSpeaker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "party",
        "speeches"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "party": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "speeches": {
          "$ref": "#/$defs/Count"
        }
      }
    },
    "SpeakerWords": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "party",
        "totalWords",
        "speeches"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "party": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "totalWords": {
          "$ref": "#/$defs/Count"
        },
        "speeches": {
          "$ref": "#/$defs/Count"
        }
      }
    },
    "SpeakerAverageWords": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "party",
        "avgWords",
        "totalWords",
        "speeches"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "party": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "avgWords": {
          "$ref": "#/$defs/Ratio"
        },
        "totalWords": {
          "$ref": "#/$defs/Count"
        },
        "speeches": {
          "$ref": "#/$defs/Count"
        }
      }
    },
    "FunFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "emoji",
        "value",
        "label",
        "category"
      ],
      "properties": {
        "emoji": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "value": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "label": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "sublabel": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "category": {
          "enum": [
            "general",
            "tone",
            "gender"
          ]
        }
      }
    },
    "GenderDistribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "male",
        "female",
        "unknown",
        "femalePercent"
      ],
      "properties": {
        "male": {
          "$ref": "#/$defs/Count"
        },
        "female": {
          "$ref": "#/$defs/Count"
        },
        "unknown": {
          "$ref": "#/$defs/Count"
        },
        "femalePercent": {
          "$ref": "#/$defs/Ratio"
        }
      }
    },
    "GenderByParty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "party",
        "male",
        "female",
        "femaleRatio"
      ],
      "properties": {
        "party": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "male": {
          "$ref": "#/$defs/Count"
        },
        "female": {
          "$ref": "#/$defs/Count"
        },
        "femaleRatio": {
          "$ref": "#/$defs/Ratio"
        }
      }
    },
    "GenderSpeaker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "party",
        "count"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "party": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "count": {
          "$ref": "#/$defs/Count"
        }
      }
    },
    "InterruptionPatterns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maleInterruptions",
        "femaleInterruptions",
        "maleInterrupted",
        "femaleInterrupted"
      ],
      "properties": {
        "maleInterruptions": {
          "$ref": "#/$defs/Count"
        },
        "femaleInterruptions": {
          "$ref": "#/$defs/Count"
        },
        "maleInterrupted": {
          "$ref": "#/$defs/Count"
        },
        "femaleInterrupted": {
          "$ref": "#/$defs/Count"
        }
      }
    },
    "GenderAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distribution",
        "byParty",
        "topFemaleSpeakersReden",
        "topMaleSpeakersReden",
        "interruptionPatterns"
      ],
      "properties": {
        "distribution": {
          "$ref": "#/$defs/GenderDistribution"
        },
        "byParty": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GenderByParty"
          }
        },
        "topFemaleSpeakersReden": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GenderSpeaker"
          }
        },
        "topMaleSpeakersReden": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GenderSpeaker"
          }
        },
        "topFemaleSpeakersAll": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GenderSpeaker"
          }
        },
        "topMaleSpeakersAll": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GenderSpeaker"
          }
        },
        "interruptionPatterns": {
          "$ref": "#/$defs/InterruptionPatterns"
        },
        "speechLength": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "male",
            "female",
            "unknown"
          ],
          "properties": {
            "male": {
              "$ref": "#/$defs/Ratio"
            },
            "female": {
              "$ref": "#/$defs/Ratio"
            },
            "unknown": {
              "$ref": "#/$defs/Ratio"
            }
          }
        },
        "academicTitles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "male",
            "female"
          ],
          "properties": {
            "male": {
              "$ref": "#/$defs/Ratio"
            },
            "female": {
              "$ref": "#/$defs/Ratio"
            }
          }
        },
        "_metrics": {
          "type": "object",
          "additionalProperties": true,
          "description": "Extensible analysis metrics map."
        }
      }
    },
    "BefragungResponder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "party",
        "responses"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "party": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "responses": {
          "$ref": "#/$defs/Count"
        }
      }
    },
    "ToneRanking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "party",
        "score"
      ],
      "properties": {
        "party": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "score": {
          "$ref": "#/$defs/Ratio"
        }
      }
    },
    "ExtendedToneScores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "affirmative",
        "aggression",
        "labeling",
        "solution_focus",
        "collaboration",
        "demand_intensity",
        "acknowledgment",
        "authority",
        "future_orientation",
        "emotional_intensity",
        "inclusivity",
        "discriminatory"
      ],
      "properties": {
        "affirmative": {
          "$ref": "#/$defs/Ratio"
        },
        "aggression": {
          "$ref": "#/$defs/Ratio"
        },
        "labeling": {
          "$ref": "#/$defs/Ratio"
        },
        "solution_focus": {
          "$ref": "#/$defs/Ratio"
        },
        "collaboration": {
          "$ref": "#/$defs/Ratio"
        },
        "demand_intensity": {
          "$ref": "#/$defs/Ratio"
        },
        "acknowledgment": {
          "$ref": "#/$defs/Ratio"
        },
        "authority": {
          "$ref": "#/$defs/Ratio"
        },
        "future_orientation": {
          "$ref": "#/$defs/Ratio"
        },
        "emotional_intensity": {
          "$ref": "#/$defs/Ratio"
        },
        "inclusivity": {
          "$ref": "#/$defs/Ratio"
        },
        "discriminatory": {
          "$ref": "#/$defs/Ratio"
        }
      }
    },
    "PartyProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "party",
        "category",
        "categoryName",
        "emoji",
        "description",
        "rank",
        "totalParties",
        "score",
        "traits",
        "scores"
      ],
      "properties": {
        "party": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "category": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "categoryName": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "emoji": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "description": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "rank": {
          "$ref": "#/$defs/Count"
        },
        "totalParties": {
          "$ref": "#/$defs/Count"
        },
        "score": {
          "$ref": "#/$defs/Ratio"
        },
        "traits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NonEmptyString"
          }
        },
        "scores": {
          "$ref": "#/$defs/ExtendedToneScores"
        },
        "archetype": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "archetypeName": {
          "$ref": "#/$defs/NonEmptyString"
        }
      }
    },
    "ToneParty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "party",
