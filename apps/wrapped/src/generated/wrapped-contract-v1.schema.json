        "party": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NonEmptyString"
          }
        },
        "correctAnswer": {
          "$ref": "#/$defs/NonEmptyString"
