{
  "name": "bundestag-wrapped",
  "private": true,
  "version": "1.0.0",
  "description": "Bundestag Wrapped - Your Year in Parliament",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-contract-validators.mjs --check && node scripts/check-production-editions.mjs && node scripts/check-preview-auth.mjs && node scripts/generate-sitemap.cjs",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/check-production-editions.mjs dist/data && node scripts/build-speech-search.mjs && node ../../scripts/write-build-info.mjs apps/wrapped apps/wrapped/dist/build-info.json",
    "check:bundle-budget": "node scripts/check-bundle-budget.cjs",
    "check:edition-surface": "node scripts/check-edition-hardcodes.cjs",
    "import:abgeordnetenwatch": "node scripts/import-abgeordnetenwatch.cjs",
    "sync:abgeordnetenwatch": "node scripts/sync-abgeordnetenwatch.cjs",
    "import:bundestag-image": "node scripts/import-bundestag-image.cjs",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "audit:performance": "node scripts/audit-performance.cjs",
    "test:a11y": "playwright test e2e/accessibility.spec.ts",
    "check:search-index": "node scripts/check-search-index-parity.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "clsx": "^2.1.1",
    "howler": "^2.2.4",
    "lucide-react": "^1.60.0",
    "motion": "^14.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "react-sounds": "^1.0.30",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/ui": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  }
}
