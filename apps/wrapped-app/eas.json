{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_NO_BUNDLE_SPLITTING": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_NO_BUNDLE_SPLITTING": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_NO_BUNDLE_SPLITTING": "1"
      },
      "android": {
        "env": {
          "EXPO_NO_BUNDLE_SPLITTING": "1",
          "ORG_GRADLE_PROJECT_reactNativeArchitectures": "armeabi-v7a,arm64-v8a",
          "GRADLE_OPTS": "-Dorg.gradle.jvmargs=\"-Xmx3g -XX:MaxMetaspaceSize=1g -XX:+HeapDumpOnOutOfMemoryError -Dfile.encoding=UTF-8\" -Dorg.gradle.parallel=false -Dorg.gradle.workers.max=2 -Dorg.gradle.daemon=false"
        }
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6757131770"
      },
      "android": {
        "track": "alpha",
        "releaseStatus": "completed"
      }
    }
  }
}
