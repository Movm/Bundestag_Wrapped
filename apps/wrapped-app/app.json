{
  "expo": {
    "name": "Bundestag Wrapped",
    "slug": "bundestag-wrapped",
    "owner": "moritzius",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "bundestag-wrapped",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0e0a14",
    "ios": {
      "bundleIdentifier": "de.bundestag.wrapped",
      "supportsTablet": false
    },
    "android": {
      "package": "de.bundestag.wrapped",
      "adaptiveIcon": {
        "backgroundColor": "#0e0a14",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0e0a14",
          "resizeMode": "contain"
        }
      ],
      "expo-status-bar",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "e90065cb-b810-4f0a-9323-ba6a6253d841"
      }
    }
  }
}
